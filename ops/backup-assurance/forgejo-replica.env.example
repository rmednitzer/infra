# Provision locally as root-owned /etc/forgejo-replica.env (0600).
# Host identity and private key are deliberately not stored in this repository.
FORGEJO_BACKUP_SOURCE=forgejo-backup-pull@SOURCE_ADDRESS
FORGEJO_BACKUP_KEY=/etc/backup-identity/PRIVATE_KEY
FORGEJO_BACKUP_KNOWN_HOSTS=/etc/backup-identity/known_hosts
