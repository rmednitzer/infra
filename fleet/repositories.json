{
  "schema_version": 1,
  "owner": "rmednitzer",
  "defaults": {
    "default_branch": "main",
    "visibility": "public",
    "require_active_ruleset": true,
    "require_pull_request": true,
    "require_no_bypass": true,
    "require_non_fast_forward": true,
    "require_deletion_protection": true,
    "require_status_checks": true,
    "required_check_integration_id": 15368,
    "require_up_to_date": true,
    "admin_controls": {
      "repository": {
        "allow_merge_commit": false,
        "allow_update_branch": true,
        "delete_branch_on_merge": true
      },
      "actions": {
        "enabled": true,
        "sha_pinning_required": true,
        "allowed_actions": "selected"
      },
      "workflow": {
        "default_workflow_permissions": "read",
        "can_approve_pull_request_reviews": false
      },
      "security": [
        "secret_scanning",
        "secret_scanning_push_protection"
      ],
      "require_vulnerability_alerts": true,
      "dependabot_enabled": false
    },
    "require_linear_history": true
  },
  "repositories": [
    {
      "name": "infra",
      "ruleset": "main-protection",
      "preferred_aggregate_context": "ci-success",
      "aggregate_gate_state": "enforced",
      "require_up_to_date": true,
      "require_immutable_oidc_subject": true
    },
    {
      "name": "relay-shell",
      "ruleset": "main-protection",
      "preferred_aggregate_context": "ci-success",
      "aggregate_gate_state": "enforced",
      "require_up_to_date": true,
      "release_tag_ruleset": "release-tag-integrity",
      "release_environment": "pypi",
      "release_reviewers": [
        "rmednitzer"
      ],
      "release_creator_ruleset": "release-tag-creators",
      "require_immutable_releases": true,
      "required_contexts": [
        "ci-success",
        "check (py3.12)",
        "check (py3.13)",
        "check (py3.14)",
        "gitleaks (secret scan)",
        "pip-audit (CVE scan)",
        "dependency-review",
        "Analyze (python) (python)",
        "Analyze (actions)",
        "release-rehearsal"
      ]
    },
    {
      "name": "6dof-ascent-sim",
      "ruleset": "main-protection",
      "preferred_aggregate_context": "ci-success",
      "aggregate_gate_state": "enforced",
      "require_immutable_oidc_subject": true
    },
    {
      "name": "automation",
      "ruleset": "main-protection",
      "preferred_aggregate_context": "ci-success",
      "aggregate_gate_state": "enforced",
      "require_up_to_date": true,
      "require_immutable_oidc_subject": true
    },
    {
      "name": "runbooks",
      "ruleset": "main-protection",
      "preferred_aggregate_context": "ci-success",
      "aggregate_gate_state": "enforced",
      "require_immutable_oidc_subject": true
    },
    {
      "name": "rmednitzer.github.io",
      "ruleset": "main-protection",
      "preferred_aggregate_context": "validate",
      "aggregate_gate_state": "enforced",
      "require_immutable_oidc_subject": true
    }
  ]
}
